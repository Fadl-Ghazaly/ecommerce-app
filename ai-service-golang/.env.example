APP_ENV=development
APP_PORT=8080

# Golang AI Service Internal Config
VECTOR_STORE_MAX=10000
MIN_SIMILARITY_SCORE=0.05

# Optional: Gemini API Key (for future cloud embedding integration)
GEMINI_API_KEY=your-gemini-api-key-here

# CORS Allowed Origins (Laravel backend & React frontend)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:3000

